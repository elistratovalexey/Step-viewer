<resources>
    <style name="Theme.StepViewer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#10151c</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">#10151c</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="DeckButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">11dp</item>
        <item name="android:paddingRight">11dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#B0BEC5</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
