#!/usr/bin/env bash
set -e
LIB=app/src/main/assets/viewer/lib
mkdir -p "$LIB/addons/controls"
TMP=$(mktemp -d)
npm install --prefix "$TMP" --no-audit --no-fund occt-import-js three@0.160.0
cp "$TMP/node_modules/occt-import-js/dist/occt-import-js.js"   "$LIB/"
cp "$TMP/node_modules/occt-import-js/dist/occt-import-js.wasm" "$LIB/"
cp "$TMP/node_modules/three/build/three.module.js"             "$LIB/"
cp "$TMP/node_modules/three/examples/jsm/controls/OrbitControls.js" "$LIB/addons/controls/"
rm -rf "$TMP"
echo "Готово: библиотеки в $LIB"
